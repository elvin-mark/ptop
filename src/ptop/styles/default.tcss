/* ptop Textual Styling */

Screen {
    background: #1e1e2e;
    color: #cdd6f4;
    layout: vertical;
}

#app_header {
    dock: top;
    height: 1;
    background: #181825;
    color: #cdd6f4;
    padding: 0 1;
}

#app_footer {
    dock: bottom;
    height: 1;
    background: #181825;
    color: #cdd6f4;
    padding: 0 1;
}

#main_content {
    height: 1fr;
    layout: grid;
    grid-size: 2 5;
    grid-columns: 1fr 1fr;
    grid-rows: auto auto auto 1fr auto;
    grid-gutter: 0 1;
    padding: 0 1;
}

/* Zoom Mode Rules */
#main_content.has-zoomed CPUBox,
#main_content.has-zoomed MemBox,
#main_content.has-zoomed DiskBox,
#main_content.has-zoomed NetBox,
#main_content.has-zoomed GPUBox,
#main_content.has-zoomed ProcessBox,
#main_content.has-zoomed AlertsBox {
    display: none;
}

#main_content.has-zoomed .zoomed {
    display: block;
    column-span: 2;
    height: 1fr;
    min-height: 100%;
}

/* Layout Presets */

/* Full Layout */
#main_content.layout-full {
    grid-size: 2 5;
    grid-columns: 1fr 1fr;
    grid-rows: auto auto auto 1fr auto;
}
#main_content.layout-full CPUBox,
#main_content.layout-full MemBox,
#main_content.layout-full DiskBox,
#main_content.layout-full NetBox,
#main_content.layout-full GPUBox,
#main_content.layout-full ProcessBox,
#main_content.layout-full AlertsBox {
    display: block;
}

/* Compact Layout (Single Column) */
#main_content.layout-compact {
    grid-size: 1 5;
    grid-columns: 1fr;
    grid-rows: auto auto auto auto 1fr;
}
#main_content.layout-compact CPUBox,
#main_content.layout-compact MemBox,
#main_content.layout-compact DiskBox,
#main_content.layout-compact NetBox,
#main_content.layout-compact ProcessBox {
    display: block;
    column-span: 1;
}
#main_content.layout-compact GPUBox,
#main_content.layout-compact AlertsBox {
    display: none;
}

/* GPU Focus Layout */
#main_content.layout-gpu {
    grid-size: 2 3;
    grid-columns: 1fr 1fr;
    grid-rows: auto auto 1fr;
}
#main_content.layout-gpu CPUBox,
#main_content.layout-gpu MemBox,
#main_content.layout-gpu GPUBox,
#main_content.layout-gpu ProcessBox {
    display: block;
}
#main_content.layout-gpu DiskBox,
#main_content.layout-gpu NetBox,
#main_content.layout-gpu AlertsBox {
    display: none;
}

/* Process Focus Layout */
#main_content.layout-proc {
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: auto 1fr;
}
#main_content.layout-proc CPUBox,
#main_content.layout-proc MemBox,
#main_content.layout-proc ProcessBox {
    display: block;
}
#main_content.layout-proc DiskBox,
#main_content.layout-proc NetBox,
#main_content.layout-proc GPUBox,
#main_content.layout-proc AlertsBox {
    display: none;
}

/* Panel Containers */
CPUBox {
    border: round #89b4fa;
    border-title-color: #cba6f7;
    height: auto;
    min-height: 5;
    padding: 0 1;
}

MemBox {
    border: round #a6e3a1;
    border-title-color: #cba6f7;
    height: auto;
    min-height: 5;
    padding: 0 1;
}

DiskBox {
    border: round #f9e2af;
    border-title-color: #cba6f7;
    height: auto;
    min-height: 5;
    padding: 0 1;
}

NetBox {
    border: round #89dceb;
    border-title-color: #cba6f7;
    height: auto;
    min-height: 5;
    padding: 0 1;
}

GPUBox {
    border: round #fab387;
    border-title-color: #cba6f7;
    height: auto;
    min-height: 3;
    column-span: 2;
    padding: 0 1;
}

ProcessBox {
    border: round #cba6f7;
    border-title-color: #cba6f7;
    height: 1fr;
    min-height: 8;
    column-span: 2;
    padding: 0 1;
}

AlertsBox {
    border: heavy #f9e2af;
    border-title-color: #f9e2af;
    height: auto;
    min-height: 3;
    column-span: 2;
    padding: 0 1;
}

/* Sparkline Widgets */
BrailleSparkline {
    height: 1;
    width: 100%;
}

/* Modal Dialogs */
ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#help_dialog, #kill_dialog, #proc_detail_dialog, #filter_dialog {
    padding: 1 2;
    background: #181825;
    border: double #89b4fa;
    width: 70;
    height: auto;
    max-height: 90%;
}

#proc_detail_dialog {
    width: 90;
}

#net_scroll_area {
    max-height: 20;
    height: auto;
}

#kill_msg, #filter_msg, #help_content, #proc_detail_content {
    margin-bottom: 1;
}

.signal_buttons {
    margin-bottom: 1;
    height: 3;
}

.signal_buttons Button {
    margin-right: 1;
}
